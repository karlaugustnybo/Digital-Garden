---
import { Tweet } from "astro-embed";

const { tweetId } = Astro.props;
---

<div class="tweet-embed">
	<Tweet id={`https://twitter.com/anyuser/status/${tweetId}`} />
</div>

<script>
	import { onPageLifecycle } from "../../utils/viewTransitionLifecycle";

	declare global {
		interface Window {
			twttr: any;
		}
	}

	onPageLifecycle(() => {
		const TWITTER_SCRIPT_SRC = "https://platform.twitter.com/widgets.js";
		const existingScript = document.querySelector(`script[src="${TWITTER_SCRIPT_SRC}"]`);
		if (existingScript) {
			existingScript.remove();
		}

		const script = document.createElement("script");
		script.src = TWITTER_SCRIPT_SRC;
		script.async = true;
		document.body.appendChild(script);

		if (window.twttr) {
			window.twttr.widgets.load();
		}

		return () => {
			const existing = document.querySelector(`script[src="${TWITTER_SCRIPT_SRC}"]`);
			if (existing) {
				existing.remove();
			}
		};
	});
</script>

<style>
	.tweet-embed {
		margin: 0 auto 1rem;
	}
</style>
