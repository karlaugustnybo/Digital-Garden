<style>
	#logo {
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	#logo:hover {
		transform: scale(1.05);
	}

	/* SVG-specific transform origin settings */
	#logo .leaf,
	#logo .leaf-2,
	#logo .letter {
		transform-origin: center;
		transform-box: fill-box;
	}

	/* Animation classes */
	.css-animate .leaf {
		animation: leafWiggle 0.6s ease-in-out;
	}

	.css-animate .leaf-2 {
		animation: leafWiggle2 0.6s ease-in-out;
	}

	.css-animate .letter {
		animation: letterPulse 0.75s ease-in-out;
	}

	@keyframes leafWiggle {
		0%,
		100% {
			transform: rotate(0deg);
		}
		25% {
			transform: rotate(10deg);
		}
		50% {
			transform: rotate(-10deg);
		}
		75% {
			transform: rotate(10deg);
		}
	}

	@keyframes leafWiggle2 {
		0%,
		100% {
			transform: rotate(0deg);
		}
		25% {
			transform: rotate(-5deg);
		}
		50% {
			transform: rotate(5deg);
		}
		75% {
			transform: rotate(-5deg);
		}
	}

	@keyframes letterPulse {
		0%,
		100% {
			transform: scale(1);
			fill: oklch(36.60% 0.02347 39.176);
		}
		50% {
			transform: scale(0.9);
			fill: oklch(46.60% 0.02347 39.176);
		}
	}
</style>

<script>
	function handleLogoAnimation() {
		const logo = document.getElementById("logo");
		if (logo) {
			logo.classList.add("css-animate");
			setTimeout(() => {
				logo.classList.remove("css-animate");
			}, 750);
		}
	}

	function initializeLogoAnimation() {
		const logo = document.getElementById("logo");
		if (logo) {
			// Remove any existing event listeners
			logo.removeEventListener("mouseenter", handleLogoAnimation);
			// Add the event listener
			logo.addEventListener("mouseenter", handleLogoAnimation);
		}
	}

	// Initialize when DOM is ready
	document.addEventListener("DOMContentLoaded", initializeLogoAnimation);

	// Re-initialize after Astro view transitions
	document.addEventListener("astro:page-load", initializeLogoAnimation);
</script>
