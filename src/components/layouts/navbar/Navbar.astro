---
import MainNavLinks from "./MainNavLinks.astro";
import Logo from "../../animated-icons/Logo.astro";
import MobileMenu from "./MobileMenu.astro";
import { Icon } from "astro-icon/components";
---

<nav class="navbar" transition:persist>
	<a href="/" aria-label="home">
		<span class="visually-hidden">Home</span>
		<Logo />
	</a>
	<div class="right-hand-side">
		<MainNavLinks />
		<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle mobile menu">
			<Icon name="heroicons:bars-3" size={28} class="menu-icon" />
			<Icon name="heroicons:x-mark" size={28} class="close-icon" />
		</button>
	</div>
</nav>

<MobileMenu />

<style>
	.right-hand-side {
		display: flex;
		align-items: center;
	}

	.navbar {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		padding: var(--space-s) var(--space-m) var(--space-s) 1.3rem;
		animation: fadeIn 0.5s 0.2s forwards;
		opacity: 0;
		background: var(--color-cream);
		position: relative;
		z-index: 1001;
	}

	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		padding: 0;
		margin-left: var(--space-s);
		cursor: pointer;
		color: var(--color-gray-800);
	}

	.mobile-menu-toggle .close-icon {
		display: none;
	}

	.mobile-menu-toggle.open .menu-icon {
		display: none;
	}

	.mobile-menu-toggle.open .close-icon {
		display: block;
	}

	@media screen and (max-width: 550px) {
		.navbar {
			padding: var(--space-s);
			margin-bottom: var(--space-m);
		}

		.mobile-menu-toggle {
			display: block;
		}
	}

	@keyframes fadeIn {
		to {
			opacity: 1;
		}
	}
</style>

<script>
	import { onPageLifecycle } from "../../../utils/viewTransitionLifecycle";

	onPageLifecycle(() => {
		const menuToggle = document.getElementById("mobile-menu-toggle") as HTMLButtonElement | null;
		const mobileMenu = document.getElementById("mobile-menu") as HTMLElement | null;

		if (!menuToggle || !mobileMenu) return;

		function openMenu() {
			menuToggle.classList.add("open");
			mobileMenu!.classList.add("open");
			document.body.style.overflow = "hidden";

			// Focus first link for keyboard users
			const firstLink = mobileMenu!.querySelector("a");
			if (firstLink) {
				setTimeout(() => firstLink.focus(), 100);
			}
		}

		function closeMenu() {
			menuToggle.classList.remove("open");
			mobileMenu!.classList.remove("open");
			document.body.style.overflow = "auto";
		}

		const toggleClickHandler = () => {
			if (mobileMenu!.classList.contains("open")) {
				closeMenu();
			} else {
				openMenu();
			}
		};

		const escapeHandler = (e: KeyboardEvent) => {
			if (e.key === "Escape" && mobileMenu!.classList.contains("open")) {
				closeMenu();
				menuToggle.focus();
			}
		};

		menuToggle.addEventListener("click", toggleClickHandler);
		document.addEventListener("keydown", escapeHandler);

		return () => {
			menuToggle.removeEventListener("click", toggleClickHandler);
			document.removeEventListener("keydown", escapeHandler);
		};
	});
</script>
