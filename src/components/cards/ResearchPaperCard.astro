---
const {
  slug,
  title,
  authors,
  abstract,
  venues,
  published,
  type,
  researchArea,
  status,
  featured,
  cover,
  doi,
  arxiv,
  pdf,
  draft
} = Astro.props;

import { Image } from "astro:assets";
import RelativeDate from "../layouts/RelativeDate.astro";
import { Icon } from "astro-icon/components";
import Badge from "../mdx/Badge.astro";
---

<a href={`/${slug}`} class="research-paper-card">
  <div class="paper-header">
    <div class="paper-type">
      <Icon name="heroicons:academic-cap" size={16} />
      <span>{type.replace('-', ' ')}</span>
    </div>
    <div class="paper-status" data-status={status}>
      <Icon name="heroicons:clock" size={14} />
      <span>{status.replace('-', ' ')}</span>
    </div>
  </div>

  {cover && (
    <div class="paper-cover">
      <Image
        src={cover}
        alt={title}
        width={300}
        height={200}
        loading="eager"
        decoding="async"
        class="cover-image"
      />
    </div>
  )}

  <div class="paper-content">
    <h3 class="paper-title">{title}</h3>

    {abstract && (
      <p class="paper-abstract">{abstract}</p>
    )}

    <div class="paper-meta">
      <div class="authors">
        {authors.slice(0, 3).map((author, index) => (
          <span class="author">
            {author}
            {index < Math.min(authors.length - 1, 2) && index < 2 && ","}
            {index === 2 && authors.length > 3 && " et al."}
          </span>
        ))}
      </div>

      {venues && venues.length > 0 && (
        <div class="venues">
          <Icon name="heroicons:building-office" size={14} />
          {venues.join(", ")}
        </div>
      )}

      <div class="paper-date">
        <Icon name="heroicons:calendar" size={14} />
        <RelativeDate postDate={published || updated} />
      </div>

      {researchArea && researchArea.length > 0 && (
        <div class="research-areas">
          {researchArea.slice(0, 3).map((area) => (
            <Badge variant="secondary" size="sm">{area}</Badge>
          ))}
        </div>
      )}
    </div>

      </div>
</a>

<style>
  .research-paper-card {
    display: flex;
    flex-direction: column;
    background: var(--color-light-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-lg);
    padding: var(--space-m);
    margin-bottom: var(--space-m);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease-in-out;
    position: relative;
    overflow: hidden;
  }

  .research-paper-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--box-shadow-lg);
    border-color: var(--color-primary-green-20);
  }

  .paper-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .paper-type {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-gray-600);
    text-transform: capitalize;
  }

  .paper-type svg {
    color: var(--color-primary-green);
  }

  .paper-status {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--font-size-xs);
    padding: 2px var(--space-2xs);
    border-radius: var(--border-radius-sm);
    font-weight: 500;
    text-transform: capitalize;
  }

  .paper-status[data-status="published"] {
    background: var(--color-primary-green-10);
    color: var(--color-primary-green);
  }

  .paper-status[data-status="preprint"] {
    background: var(--color-accent-brown-10);
    color: var(--color-accent-brown);
  }

  .paper-status[data-status="in-progress"] {
    background: var(--color-gray-200);
    color: var(--color-gray-600);
  }

  
  .paper-cover {
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    border-radius: var(--border-radius-base);
    margin-bottom: var(--space-s);
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }

  .research-paper-card:hover .cover-image {
    transform: scale(1.05);
  }

  .paper-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .paper-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    margin-bottom: var(--space-xs);
    color: var(--color-gray-800);
    transition: color 0.3s ease-in-out;
  }

  .research-paper-card:hover .paper-title {
    color: var(--color-accent-brown);
  }

  .paper-abstract {
    font-size: var(--font-size-sm);
    line-height: var(--leading-base);
    color: var(--color-gray-600);
    margin-bottom: var(--space-s);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .paper-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-s);
  }

  .authors {
    font-size: var(--font-size-sm);
    color: var(--color-gray-700);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .author {
    display: inline;
    margin-right: var(--space-2xs);
  }

  .venues {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--font-size-xs);
    color: var(--color-gray-600);
    line-height: var(--leading-snug);
  }

  .venues svg {
    color: var(--color-gray-500);
    flex-shrink: 0;
  }

  .paper-date {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--font-size-xs);
    color: var(--color-gray-600);
    line-height: var(--leading-snug);
  }

  .paper-date svg {
    color: var(--color-gray-500);
    flex-shrink: 0;
  }

  .research-areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  
  @media (max-width: 768px) {
    .research-paper-card {
      padding: var(--space-s);
      margin-bottom: var(--space-s);
    }

    .paper-title {
      font-size: var(--font-size-base);
    }

    .paper-abstract {
      font-size: var(--font-size-sm);
      -webkit-line-clamp: 2;
    }

    .paper-meta {
      gap: var(--space-2xs);
    }

    .authors {
      font-size: var(--font-size-xs);
    }

      }

  @media (max-width: 480px) {
    .research-paper-card {
      padding: var(--space-s);
    }

    .paper-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }

    .paper-type,
    .paper-status {
      font-size: 10px;
    }

    .featured-badge {
      position: static;
      margin-bottom: var(--space-xs);
      align-self: flex-start;
    }
  }
</style>