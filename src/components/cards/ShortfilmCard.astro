---
interface Props {
	slug: string;
	cover?: ImageMetadata;
	title: string;
	growthStage?: "seedling" | "budding" | "evergreen";
	date: Date;
	description?: string;
	id?: string;
	duration?: string;
}

const { slug, cover, title, growthStage, date, description, id, duration } = Astro.props;
import BlurImage from "./BlurImage.astro";
import RelativeDate from "../layouts/RelativeDate.astro";
import GrowthIcon from "../layouts/GrowthIcon.astro";
---

<div class="shortfilm-card" data-card-link={`/${slug}`}>
	{
		cover && (
			<div class="image-wrapper">
				<BlurImage
					src={cover}
					alt={title}
					width={400}
					height={400}
					loading="eager"
					decoding="async"
				/>
			</div>
		)
	}
	<h3 transition:name={`title-${slug}`}>{title}</h3>
	<p class="description">{description}</p>
	<div class="metadata-container">
		<span>Short Film</span>
		{growthStage && <GrowthIcon size="15" growthStage={growthStage} />}
		{duration && <span>{duration}</span>}
		<span>
			<RelativeDate postDate={date} />
		</span>
	</div>
</div>

<style>
	.image-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.image-wrapper :global(.blur-image-wrapper) {
		width: 100%;
		height: 100%;
	}

	.image-wrapper :global(.blur-full) {
		transition:
			opacity 0.4s ease-out,
			transform 0.3s ease-in-out;
		will-change: transform;
	}

	.metadata-container {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		text-transform: capitalize;
		color: var(--color-gray-500);
		font-weight: 400;
		margin-top: 6px;
		gap: var(--space-2xs);
	}

	.metadata-container :global(svg) {
		margin: 0 var(--space-2xs);
	}

	.description {
		font-size: var(--font-size-xs);
		color: var(--color-gray-500);
		font-family: var(--font-sans);
		font-weight: 400;
		margin-top: 4px;
	}

	.shortfilm-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-tinted-cream);
		padding: var(--space-s);
		margin: 0 var(--space-2xs) var(--space-2xs) 0;
		border-radius: var(--border-radius-base);
		box-shadow: var(--box-shadow-sm);
		background: var(--color-light-cream);
		transition: all 0.3s ease-in-out;
		will-change: transform, box-shadow;
		color: var(--color-gray-800);
		cursor: pointer;
		user-select: text;
		-webkit-user-select: text;
	}

	.shortfilm-card img {
		width: 100%;
	}

	.shortfilm-card h3 {
		transition: all 0.3s ease-in-out;
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 400;
		line-height: var(--leading-snug);
		margin: var(--space-2xs) 0;
	}

	.shortfilm-card:hover {
		box-shadow: var(--box-shadow-lg);
		transform: scale3d(1.02, 1.02, 1.02);
	}

	.shortfilm-card:hover h3 {
		color: var(--color-accent-brown);
	}
</style>
