---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Title1 from "../components/mdx/typography/Title1.astro";
import Title2 from "../components/mdx/typography/Title2.astro";
import ResearchPaperCard from "../components/cards/ResearchPaperCard.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import { Icon } from "astro-icon/components";
import Badge from "../components/mdx/Badge.astro";

// Get all research content
const researchPapers = await getCollection("research", ({ data }) => !data.draft);

// Group papers by type
const papersByType = researchPapers.reduce((acc, paper) => {
  const type = paper.data.type;
  if (!acc[type]) acc[type] = [];
  acc[type].push(paper);
  return acc;
}, {});

// Get unique research areas
const researchAreas = [...new Set(researchPapers.flatMap(paper => paper.data.researchArea || []))].sort();

// Get unique statuses
const statuses = [...new Set(researchPapers.map(paper => paper.data.status))].sort();

// Sort papers by date (most recent first)
const recentPapers = researchPapers
  .sort((a, b) => new Date(b.data.updated || b.data.published).getTime() - new Date(a.data.updated || a.data.published).getTime())
  .slice(0, 6);

// Featured papers
const featuredPapers = researchPapers
  .filter(paper => paper.data.featured)
  .sort((a, b) => new Date(b.data.updated || b.data.published).getTime() - new Date(a.data.updated || a.data.published).getTime());
---

<Layout title="Research Lab - Karl August Krogh Nybo" desc="Academic research and papers on AI safety, machine learning, and computational neuroscience">
  <PageWrapper>
    <header class="research-header">
      <div class="header-icon">
        <Icon name="heroicons:academic-cap" size={48} />
      </div>
      <Title1 class="research-title">Research Lab</Title1>
      <p class="research-subtitle">
        Academic research on AI safety, machine learning, and computational neuroscience.
        Explore papers, preprints, and work-in-progress findings.
      </p>

      <div class="research-stats">
        <div class="stat">
          <span class="stat-number">{researchPapers.length}</span>
          <span class="stat-label">Papers</span>
        </div>
        <div class="stat">
          <span class="stat-number">{researchAreas.length}</span>
          <span class="stat-label">Research Areas</span>
        </div>
        <div class="stat">
          <span class="stat-number">{statuses.filter(s => s === 'published' || s === 'presented').length}</span>
          <span class="stat-label">Publications</span>
        </div>
      </div>
    </header>

    <!-- Featured Papers -->
    {featuredPapers.length > 0 && (
      <section class="featured-section">
        <h2 class="section-title">
          <Icon name="heroicons:star" size={24} />
          Featured Research
        </h2>
        <div class="papers-grid featured-grid">
          {featuredPapers.map((paper) => (
            <ResearchPaperCard
              slug={paper.id}
              title={paper.data.title}
              authors={paper.data.authors}
              abstract={paper.data.abstract}
              venues={paper.data.venues}
              published={paper.data.published}
              type={paper.data.type}
              researchArea={paper.data.researchArea}
              status={paper.data.status}
              featured={paper.data.featured}
              cover={paper.data.cover}
              doi={paper.data.doi}
              arxiv={paper.data.arxiv}
              pdf={paper.data.pdf}
              updated={paper.data.updated}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Recent Papers -->
    <section class="recent-section">
      <h2 class="section-title">
        <Icon name="heroicons:clock" size={24} />
        Recent Research
      </h2>
      <div class="papers-grid">
        {recentPapers.map((paper) => (
          <ResearchPaperCard
            slug={paper.id}
            title={paper.data.title}
            authors={paper.data.authors}
            abstract={paper.data.abstract}
            venues={paper.data.venues}
            published={paper.data.published}
            type={paper.data.type}
            researchArea={paper.data.researchArea}
            status={paper.data.status}
            featured={paper.data.featured}
            cover={paper.data.cover}
            doi={paper.data.doi}
            arxiv={paper.data.arxiv}
            pdf={paper.data.pdf}
            updated={paper.data.updated}
          />
        ))}
      </div>
    </section>

    <!-- Research Areas -->
    <section class="areas-section">
      <h2 class="section-title">
        <Icon name="heroicons:tag" size={24} />
        Research Areas
      </h2>
      <div class="areas-grid">
        {researchAreas.map((area) => {
          const areaPapers = researchPapers.filter(paper => paper.data.researchArea?.includes(area));
          return (
            <div class="area-card">
              <h3 class="area-title">{area}</h3>
              <p class="area-count">{areaPapers.length} paper{areaPapers.length !== 1 ? 's' : ''}</p>
              <div class="area-papers">
                {areaPapers.slice(0, 3).map((paper) => (
                  <a href={`/${paper.id}`} class="area-paper-link">
                    {paper.data.title}
                  </a>
                ))}
                {areaPapers.length > 3 && (
                  <span class="area-more">
                    +{areaPapers.length - 3} more
                  </span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- By Type -->
    <section class="by-type-section">
      <h2 class="section-title">
        <Icon name="heroicons:folder" size={24} />
        Browse by Type
      </h2>
      <div class="type-tabs">
        {Object.entries(papersByType).map(([type, papers]) => (
          <button class="type-tab" data-type={type}>
            <Icon name="heroicons:document-text" size={16} />
            {type.replace('-', ' ')} ({papers.length})
          </button>
        ))}
      </div>

      <div class="type-content">
        {Object.entries(papersByType).map(([type, papers]) => (
          <div class="type-papers" data-type-content={type} style="display: none;">
            <div class="papers-grid">
              {papers.map((paper) => (
                <ResearchPaperCard
                  slug={paper.id}
                  title={paper.data.title}
                  authors={paper.data.authors}
                  abstract={paper.data.abstract}
                  venues={paper.data.venues}
                  published={paper.data.published}
                  type={paper.data.type}
                  researchArea={paper.data.researchArea}
                  status={paper.data.status}
                  featured={paper.data.featured}
                  cover={paper.data.cover}
                  doi={paper.data.doi}
                  arxiv={paper.data.arxiv}
                  pdf={paper.data.pdf}
                  updated={paper.data.updated}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Status Overview -->
    <section class="status-section">
      <h2 class="section-title">
        <Icon name="heroicons:flag" size={24} />
        Research Status
      </h2>
      <div class="status-grid">
        {statuses.map((status) => {
          const statusPapers = researchPapers.filter(paper => paper.data.status === status);
          return (
            <div class="status-card">
              <div class="status-header">
                <Badge
                  variant={status === 'published' ? 'primary' : status === 'preprint' ? 'secondary' : 'gray'}
                  size="md"
                >
                  {status.replace('-', ' ')}
                </Badge>
                <span class="status-count">{statusPapers.length}</span>
              </div>
              <div class="status-papers">
                {statusPapers.slice(0, 2).map((paper) => (
                  <a href={`/${paper.id}`} class="status-paper-link">
                    {paper.data.authors[0]} et al. ({new Date(paper.data.published || paper.data.updated).getFullYear()})
                  </a>
                ))}
                {statusPapers.length > 2 && (
                  <span class="status-more">
                    +{statusPapers.length - 2} more
                  </span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </PageWrapper>
</Layout>

<script>
  // Tab functionality for research types
  document.addEventListener('DOMContentLoaded', () => {
    const typeTabs = document.querySelectorAll('.type-tab');
    const typeContents = document.querySelectorAll('.type-papers');

    typeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const type = tab.dataset.type;

        // Update active tab
        typeTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        // Show corresponding content
        typeContents.forEach(content => {
          if (content.dataset.typeContent === type) {
            content.style.display = 'block';
          } else {
            content.style.display = 'none';
          }
        });
      });
    });

    // Show first type by default
    if (typeTabs.length > 0) {
      typeTabs[0].click();
    }
  });
</script>

<style>
  .research-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
    padding: var(--space-2xl) 0;
    background: var(--color-cream);
    border-radius: var(--border-radius-lg);
    position: relative;
    overflow: hidden;
  }

  
  .header-icon {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-m);
  }

  .header-icon svg {
    color: var(--color-primary-green);
  }

  .research-title {
    margin-bottom: var(--space-s);
    text-align: center;
  }

  .research-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-gray-600);
    max-width: 800px;
    margin: 0 auto var(--space-l);
    line-height: var(--leading-base);
  }

  .research-stats {
    display: flex;
    justify-content: center;
    gap: var(--space-2xl);
    margin-top: var(--space-l);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-primary-green);
    font-family: var(--font-serif);
  }

  .stat-label {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    color: var(--color-gray-800);
    margin-bottom: var(--space-l);
    position: relative;
  }

  .section-title svg {
    color: var(--color-primary-green);
  }

  
  .featured-section {
    margin-bottom: var(--space-3xl);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--space-m);
  }

  .papers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-m);
  }

  .areas-section {
    margin-bottom: var(--space-3xl);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-m);
  }

  .area-card {
    background: var(--color-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-base);
    padding: var(--space-m);
    transition: all 0.3s ease-in-out;
  }

  .area-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--box-shadow-md);
    border-color: var(--color-primary-green-20);
  }

  .area-title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-xs);
  }

  .area-count {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--space-s);
  }

  .area-papers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .area-paper-link {
    font-size: var(--font-size-xs);
    color: var(--color-accent-brown);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color 0.2s ease-in-out;
  }

  .area-paper-link:hover {
    color: var(--color-primary-green);
    text-decoration: underline;
  }

  .area-more {
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
    font-style: italic;
  }

  .by-type-section {
    margin-bottom: var(--space-3xl);
  }

  .type-tabs {
    display: flex;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
    flex-wrap: wrap;
    border-bottom: 2px solid var(--color-tinted-cream);
    padding-bottom: var(--space-s);
  }

  .type-tab {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-s) var(--space-m);
    background: transparent;
    border: none;
    border-radius: var(--border-radius-base) var(--border-radius-base) 0 0;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-gray-600);
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    position: relative;
  }

  .type-tab:hover {
    color: var(--color-primary-green);
    background: var(--color-light-cream);
  }

  .type-tab.active {
    color: var(--color-primary-green);
    background: var(--color-light-cream);
    border-bottom: 2px solid var(--color-primary-green);
  }

  .type-tab.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary-green);
  }

  .type-tab svg {
    color: inherit;
  }

  .status-section {
    margin-bottom: var(--space-3xl);
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-m);
  }

  .status-card {
    background: var(--color-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-base);
    padding: var(--space-m);
    transition: all 0.3s ease-in-out;
  }

  .status-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--box-shadow-md);
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-s);
  }

  .status-count {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-gray-800);
    font-family: var(--font-serif);
  }

  .status-papers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .status-paper-link {
    font-size: var(--font-size-xs);
    color: var(--color-gray-700);
    text-decoration: none;
    transition: color 0.2s ease-in-out;
  }

  .status-paper-link:hover {
    color: var(--color-accent-brown);
    text-decoration: underline;
  }

  .status-more {
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .research-header {
      padding: var(--space-l) var(--space-m);
      margin-bottom: var(--space-2xl);
    }

    .research-subtitle {
      font-size: var(--font-size-base);
      margin-bottom: var(--space-m);
    }

    .research-stats {
      gap: var(--space-l);
      flex-wrap: wrap;
    }

    .stat {
      min-width: 80px;
    }

    .section-title {
      font-size: var(--font-size-lg);
      margin-bottom: var(--space-m);
    }

    .featured-grid,
    .papers-grid {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }

    .areas-grid,
    .status-grid {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }

    .type-tabs {
      gap: var(--space-xs);
      margin-bottom: var(--space-m);
      padding-bottom: var(--space-s);
      overflow-x: auto;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .type-tab {
      padding: var(--space-xs) var(--space-s);
      font-size: var(--font-size-xs);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .area-card,
    .status-card {
      padding: var(--space-s);
    }
  }

  @media (max-width: 480px) {
    .research-header {
      padding: var(--space-m);
    }

    .research-stats {
      gap: var(--space-s);
    }

    .stat-number {
      font-size: var(--font-size-xl);
    }

    .featured-grid,
    .papers-grid {
      gap: var(--space-xs);
    }
  }
</style>