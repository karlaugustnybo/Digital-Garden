---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import TableOfContents from "../components/layouts/TableOfContents.astro";
import ProseWrapper from "../components/layouts/ProseWrapper.astro";
import Badge from "../components/mdx/Badge.astro";
import RelativeDate from "../components/layouts/RelativeDate.astro";

interface Props {
  frontmatter: CollectionEntry<"research">["data"];
  headings: MarkdownHeading[];
  entry: CollectionEntry<"research">;
}

const { frontmatter, headings, entry } = Astro.props;

// Generate citation formats
const generateAPA = (paper: CollectionEntry<"research">) => {
  const authors = paper.data.authors.join(", ");
  const year = new Date(paper.data.published || paper.data.updated).getFullYear();
  const title = paper.data.title;
  const venue = paper.data.venues?.join(", ") || "";

  return `${authors} (${year}). ${title}. ${venue}`;
};

const generateBibTeX = (paper: CollectionEntry<"research">) => {
  const authors = paper.data.authors.map(author => author.split(" ").reverse().join(", ")).join(" and ");
  const year = new Date(paper.data.published || paper.data.updated).getFullYear();
  const title = paper.data.title;
  const venue = paper.data.venues?.[0] || "";
  const key = paper.data.title.toLowerCase().replace(/\s+/g, "").replace(/[^\w]/g, "");

  return `@article{${key},
  title={${title}},
  author={${authors}},
  year={${year}},
  journal={${venue}}
}`;
};

---

<Layout title={frontmatter.title} desc={frontmatter.description}>
  <div class="research-paper-layout">
    <!-- Paper Header -->
    <header class="paper-header">
      <div class="paper-meta-top">
        <div class="paper-type-status">
          <Badge variant="secondary" size="sm">
            <Icon name="heroicons:academic-cap" size={14} />
            {frontmatter.type.replace('-', ' ')}
          </Badge>
          <Badge
            variant={
              frontmatter.status === 'published' ? 'primary' :
              frontmatter.status === 'preprint' ? 'secondary' :
              'gray'
            }
            size="sm"
          >
            <Icon name="heroicons:clock" size={14} />
            {frontmatter.status.replace('-', ' ')}
          </Badge>
          {frontmatter.featured && (
            <Badge variant="salmon" size="sm">
              <Icon name="heroicons:star" size={14} />
              Featured
            </Badge>
          )}
        </div>

        <div class="paper-actions">
          {frontmatter.pdf && (
            <a href={frontmatter.pdf} class="action-button primary" download>
              <Icon name="heroicons:document-arrow-down" size={16} />
              Download PDF
            </a>
          )}
          {frontmatter.arxiv && (
            <a href={frontmatter.arxiv} class="action-button" target="_blank" rel="noopener noreferrer">
              <Icon name="heroicons:document-text" size={16} />
              arXiv
            </a>
          )}
          {frontmatter.doi && (
            <a href={`https://doi.org/${frontmatter.doi}`} class="action-button" target="_blank" rel="noopener noreferrer">
              <Icon name="heroicons:link" size={16} />
              DOI
            </a>
          )}
        </div>
      </div>

      <h1 class="paper-title">{frontmatter.title}</h1>

      {frontmatter.authors && (
        <div class="paper-authors">
          {frontmatter.authors.map((author, index) => (
            <span class="author">
              {author}
              {index < frontmatter.authors.length - 1 && index < 4 && ","}
              {index === 4 && frontmatter.authors.length > 5 && " et al."}
            </span>
          ))}
        </div>
      )}

      <div class="paper-venue-date">
        {frontmatter.venues && frontmatter.venues.length > 0 && (
          <div class="venue">
            <Icon name="heroicons:building-office" size={14} />
            {frontmatter.venues.join(", ")}
          </div>
        )}
        <div class="publication-date">
          <Icon name="heroicons:calendar" size={14} />
          <RelativeDate postDate={frontmatter.published || frontmatter.updated} />
        </div>
      </div>

      {frontmatter.abstract && (
        <div class="paper-abstract">
          <h2>Abstract</h2>
          <p>{frontmatter.abstract}</p>
        </div>
      )}

      <div class="paper-links">
        {frontmatter.code && (
          <a href={frontmatter.code} class="paper-link" target="_blank" rel="noopener noreferrer">
            <Icon name="heroicons:code-bracket" size={16} />
            Code
          </a>
        )}
        {frontmatter.data && (
          <a href={frontmatter.data} class="paper-link" target="_blank" rel="noopener noreferrer">
            <Icon name="heroicons:chart-bar" size={16} />
            Data
          </a>
        )}
        {frontmatter.slides && (
          <a href={frontmatter.slides} class="paper-link" target="_blank" rel="noopener noreferrer">
            <Icon name="heroicons:presentation-chart-line" size={16} />
            Slides
          </a>
        )}
        {frontmatter.video && (
          <a href={frontmatter.video} class="paper-link" target="_blank" rel="noopener noreferrer">
            <Icon name="heroicons:video-camera" size={16} />
            Video
          </a>
        )}
      </div>

      {frontmatter.researchArea && frontmatter.researchArea.length > 0 && (
        <div class="paper-topics">
          <h3>Research Areas</h3>
          <div class="topic-badges">
            {frontmatter.researchArea.map((area) => (
              <Badge variant="primary" size="sm">{area}</Badge>
            ))}
          </div>
        </div>
      )}
    </header>

    <!-- Paper Content -->
    <div class="paper-content">
      {frontmatter.toc && <TableOfContents headings={headings} />}

      <main class="paper-main">
        <ProseWrapper>
          <slot />
        </ProseWrapper>
      </main>
    </div>

    <!-- Citation Section -->
    <section class="citation-section">
      <h2>Cite This Paper</h2>

      <div class="citation-formats">
        <div class="citation-format">
          <h3>APA</h3>
          <code class="citation-text">{generateAPA(entry)}</code>
          <button class="copy-button" data-citation={generateAPA(entry)}>
            <Icon name="heroicons:clipboard-document" size={16} />
            Copy
          </button>
        </div>

        <div class="citation-format">
          <h3>BibTeX</h3>
          <pre class="citation-text bibtex">{generateBibTeX(entry)}</pre>
          <button class="copy-button" data-citation={generateBibTeX(entry)}>
            <Icon name="heroicons:clipboard-document" size={16} />
            Copy
          </button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Copy citation functionality
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-button');

    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const citation = button.dataset.citation;

        try {
          await navigator.clipboard.writeText(citation);
          const originalText = button.innerHTML;
          button.innerHTML = '<Icon name="heroicons:check" size={16} /> Copied!';
          button.classList.add('copied');

          setTimeout(() => {
            button.innerHTML = originalText;
            button.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy citation:', err);
        }
      });
    });
  });

  // Re-initialize after Astro page transitions
  document.addEventListener('astro:page-load', () => {
    // Re-run citation initialization
    setTimeout(() => {
      const copyButtons = document.querySelectorAll('.copy-button');
      copyButtons.forEach(button => {
        // Reset any existing event listeners and re-attach
        button.onclick = async () => {
          const citation = button.dataset.citation;
          try {
            await navigator.clipboard.writeText(citation);
            const originalText = button.innerHTML;
            button.innerHTML = '<Icon name="heroicons:check" size={16} /> Copied!';
            button.classList.add('copied');

            setTimeout(() => {
              button.innerHTML = originalText;
              button.classList.remove('copied');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy citation:', err);
          }
        };
      });
    }, 100);
  });
</script>

<style>
  .research-paper-layout {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-m);
  }

  .paper-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 2px solid var(--color-tinted-cream);
  }

  .paper-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-l);
    gap: var(--space-m);
  }

  .paper-type-status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .paper-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--border-radius-base);
    text-decoration: none;
    font-size: var(--font-size-xs);
    font-weight: 500;
    transition: all 0.2s ease-in-out;
    border: 1px solid var(--color-tinted-cream);
    background: var(--color-cream);
    color: var(--color-gray-700);
  }

  .action-button:hover {
    transform: translateY(-1px);
    box-shadow: var(--box-shadow-sm);
  }

  .action-button.primary {
    background: var(--color-primary-green);
    color: white;
    border-color: var(--color-primary-green);
  }

  .action-button.primary:hover {
    background: var(--color-primary-green);
    filter: brightness(1.1);
  }

  .paper-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    color: var(--color-gray-800);
    margin-bottom: var(--space-m);
  }

  .paper-authors {
    font-size: var(--font-size-lg);
    color: var(--color-gray-700);
    margin-bottom: var(--space-s);
    font-style: normal;
  }

  .author {
    margin-right: var(--space-2xs);
  }

  .paper-venue-date {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
    font-size: var(--font-size-base);
    color: var(--color-gray-600);
  }

  .venue,
  .publication-date {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .venue svg,
  .publication-date svg {
    color: var(--color-gray-500);
  }

  .paper-abstract {
    background: var(--color-light-cream);
    padding: var(--space-l);
    border-radius: var(--border-radius-base);
    margin-bottom: var(--space-l);
    border-left: 4px solid var(--color-primary-green);
  }

  .paper-abstract h2 {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-s);
    color: var(--color-gray-800);
  }

  .paper-abstract p {
    font-size: var(--font-size-base);
    line-height: var(--leading-base);
    color: var(--color-gray-700);
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }

  .paper-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    background: var(--color-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-base);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-accent-brown);
    transition: all 0.2s ease-in-out;
  }

  .paper-link:hover {
    background: var(--color-accent-brown-10);
    border-color: var(--color-accent-brown-20);
    transform: translateY(-1px);
  }

  .paper-topics {
    margin-bottom: var(--space-l);
  }

  .paper-topics h3 {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-gray-600);
    margin-bottom: var(--space-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .topic-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .paper-content {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
  }

  .paper-main {
    min-width: 0; /* Prevents overflow issues */
  }

  .citation-section {
    background: var(--color-light-cream);
    padding: var(--space-xl);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-tinted-cream);
  }

  .citation-section h2 {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-l);
    color: var(--color-gray-800);
  }

  .citation-formats {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .citation-format {
    position: relative;
  }

  .citation-format h3 {
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: var(--space-s);
    color: var(--color-gray-700);
  }

  .citation-text {
    display: block;
    background: var(--color-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-base);
    padding: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--leading-base);
    color: var(--color-gray-700);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .citation-text.bibtex {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .copy-button {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-cream);
    border: 1px solid var(--color-tinted-cream);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-gray-600);
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .copy-button:hover {
    background: var(--color-primary-green-10);
    border-color: var(--color-primary-green-20);
    color: var(--color-primary-green);
  }

  .copy-button.copied {
    background: var(--color-primary-green);
    color: white;
    border-color: var(--color-primary-green);
  }

  
  /* Mobile Responsive */
  @media (max-width: 768px) {
    .research-paper-layout {
      padding: var(--space-l) var(--space-s);
    }

    .paper-meta-top {
      flex-direction: column;
      gap: var(--space-s);
    }

    .paper-actions {
      justify-content: flex-start;
    }

    .paper-title {
      font-size: var(--font-size-2xl);
    }

    .paper-authors {
      font-size: var(--font-size-base);
    }

    .paper-venue-date {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .paper-links {
      gap: var(--space-xs);
    }

    .paper-content {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .citation-section {
      padding: var(--space-l);
    }

    .citation-formats {
      gap: var(--space-m);
    }

    .copy-button {
      position: static;
      margin-top: var(--space-s);
    }
  }

  @media (max-width: 480px) {
    .research-paper-layout {
      padding: var(--space-m);
    }

    .paper-title {
      font-size: var(--font-size-xl);
    }

    .paper-abstract {
      padding: var(--space-m);
    }

    .citation-section {
      padding: var(--space-m);
    }
  }
</style>